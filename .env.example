# Credentials for BOTH local backends.
# Copy to .env and set real values:  cp .env.example .env
# docker compose reads USERNAME / PASSWORD for both services; the app also
# accepts these as a fallback, so one .env works everywhere.
USERNAME=docdbadmin
PASSWORD=change-me

# ---------------------------------------------------------------------------
# THE ONE FLAG: choose the backend. No application code changes.
#   documentdb -> localhost:10260, TLS on (self-signed, local dev bypass)
#   mongodb    -> localhost:27017, TLS off (official mongo:8 image)
# Override without editing this file:  npm run dev -- --backend mongodb
# ---------------------------------------------------------------------------
DB_BACKEND=documentdb

# ---------------------------------------------------------------------------
# Optional connection overrides. Normally leave these UNSET - the preset above
# supplies the URI, TLS and authSource. Setting DOCUMENTDB_URI pins the endpoint
# regardless of DB_BACKEND (handy for a remote or custom instance).
#
# The Node.js quick start uses DOCUMENTDB_USERNAME / DOCUMENTDB_PASSWORD; if set
# they take precedence over USERNAME / PASSWORD above.
# ---------------------------------------------------------------------------
# DOCUMENTDB_USERNAME=docdbadmin
# DOCUMENTDB_PASSWORD=change-me
# DOCUMENTDB_URI=mongodb://localhost:10260/
# DOCUMENTDB_TLS=true
# DOCUMENTDB_TLS_ALLOW_INVALID_CERTS=true
# DOCUMENTDB_TLS_CA_FILE=/absolute/path/documentdb-cert.pem
# DOCUMENTDB_AUTH_SOURCE=admin

# Shared by both backends: same database and collection either way.
DOCUMENTDB_DB=quickstart
DOCUMENTDB_COLLECTION=movies

PORT=3000
NODE_ENV=development

# Optional: protects all /admin/* endpoints.
# Send it as `X-Admin-Token: <token>` or `Authorization: Bearer <token>`.
# When NODE_ENV=production and this is unset, /admin/* is disabled entirely.
# ADMIN_TOKEN=change-me-admin

# Caps for raw endpoints (prevent accidentally huge responses).
RAW_DEFAULT_LIMIT=100
RAW_MAX_LIMIT=1000
